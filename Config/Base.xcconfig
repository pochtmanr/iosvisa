// Base build settings shared by every configuration.
// Non-secret only. Real keys belong in Secrets.xcconfig (git-ignored).

// Custom URL scheme used for auth callbacks (visapassage://auth/callback) and deep links.
APP_URL_SCHEME = visapassage

// Universal Link host (must match apple-app-site-association on the web domain).
APP_UNIVERSAL_LINK_HOST = visapassage.com
