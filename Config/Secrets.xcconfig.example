#include "Base.xcconfig"

// Copy this file to `Secrets.xcconfig` and fill in the values, then run
// `xcodegen generate`. These are the PUBLIC Supabase client credentials
// (safe to embed in an app bundle — the same anon key ships in the web
// bundle). NEVER put the service-role key here.
//
// We store the Supabase HOST only (no scheme) because xcconfig treats `//`
// as the start of a comment. AppConfig rebuilds the full https:// URL in code.

SUPABASE_HOST = eujmomonscnlmwcbkbfy.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here

// iOS OAuth client ID from the Google Cloud console (Application type: iOS).
// REVERSED is the same value with the two leading dot-segments swapped; it is
// registered as a URL scheme so the GoogleSignIn SDK can receive the redirect.
// See docs/AUTH-SETUP.md for the full provisioning steps.
GOOGLE_IOS_CLIENT_ID = your-google-ios-client-id.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.your-google-ios-client-id

// Apple Developer Team ID (10 chars, from the Membership page). Needed for code
// signing and the Sign in with Apple capability.
DEVELOPMENT_TEAM = your-apple-team-id
