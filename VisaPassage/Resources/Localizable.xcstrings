    "Visa-free": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без визы"
          }
        }
      }
    },
    "Visa-free days across the whole Schengen area count together: at most 90 days in any rolling 180-day period.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвизовые дни во всей Шенгенской зоне суммируются: не более 90 дней в любом скользящем периоде из 180 дней."
          }
        }
      }
    },
    "Visa-free to %lld": {
      "localizations": {
        "ru": {
