    "Visit": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездки"
          }
        }
      }
    },
    "We couldn't create the account. Please try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать аккаунт. Попробуйте ещё раз."
          }
        }
      }
    },
    "We couldn't send the link. Check the address and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить ссылку. Проверьте адрес и попробуйте ещё раз."
          }
        }
      }
    },
    "We couldn't send the reset link. Please try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить ссылку для сброса пароля. Попробуйте ещё раз."
          }
        }
      }
    },
    "We have no short-stay answer for this route yet. Check the official source before you travel.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответа для краткосрочной поездки по этому маршруту у нас пока нет. Перед поездкой уточните условия по официальному источнику."
          }
        }
      }
    },
    "We've emailed a sign-in link to %@. Open it on this device.": {
      "localizations": {
