{
  "sourceLanguage": "en",
  "strings": {
    "%@ for %@ passport holders: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (паспорт: %2$@): %3$@"
          }
        }
      }
    },
    "%@ has %@ across work, study, residence and other purposes. Eligibility varies by route and nationality — see the full %@ visa guide for details.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ для работы, учёбы, проживания и других целей. Право на каждый зависит от маршрута и гражданства — подробности в полном визовом гиде: %3$@."
          }
        }
      }
    },
    "%@ is planned": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — планируется"
          }
        }
      }
    },
    "%@ passport": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Паспорт: %@"
          }
        }
      }
    },
    "%@ per visit under the %@ arrangement, as of our last verification. Longer stays or other purposes use a dedicated visa route.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ за поездку в режиме «%2$@» — по данным нашей последней проверки. Для более долгого пребывания или других целей используется отдельный визовый маршрут."
          }
        }
      }
    },
    "%@ planned": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — планируется"
          }
        }
      }
    },
